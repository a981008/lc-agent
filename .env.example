# lc-agent 环境配置示例 — 复制为 .env 后按需修改
# 敏感值也可以运行后在面板/API 中配置（推荐），本文件只放非敏感项。

# 服务
PORT=3081
BIND=127.0.0.1
DATA_DIR=./data

# 敏感数据加密密钥（32+ 字符）。留空则首次启动自动生成并写入 data/secret.key
SECRET_KEY=

# Dashboard 访问 Token。留空则首次启动自动生成（打印到控制台并写入 data/dashboard-token.txt）
ADMIN_TOKEN=

# 沙盒镜像
SANDBOX_IMAGE=lc-agent-sandbox:latest
